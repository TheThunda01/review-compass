// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/devcontainers/images/tree/main/src/javascript-node
{
  "name": "Review Compass static workspace",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4
  },
  "waitFor": "postCreateCommand",
  "updateContentCommand": "npm ci --ignore-scripts",
  "postCreateCommand": "npm test",

  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "GitHub.copilot"
      ],
      "settings": {
        "emmet.includeLanguages": {
          "javascript": "javascriptreact"
        },
        "emmet.triggerExpansionOnTab": true
      }
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "22"},
    "ghcr.io/devcontainers/features/python:1": {"version": "3.12"}
  },

  "portsAttributes": {
    "8000": {
      "label": "Review Compass (start the README server manually)",
      "onAutoForward": "openPreview"
    }
  },

  "forwardPorts": [8000]
}
