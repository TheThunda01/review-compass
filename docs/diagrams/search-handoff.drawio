          <mxGeometry x="345" y="405" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="record" value="Operator-reported JSON&#10;Platform, date, limits,&#10;status, count&#10;Unknown count stays null" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#e0f0ec;strokeColor=#528b79;fontColor=#173e32;" vertex="1" parent="1">
