        <mxCell id="export" value="Markdown export&#10;Current draft and notes&#10;No inclusion decision" style="html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;spacing=12;rounded=1;fillColor=#eef4f8;strokeColor=#88a8b7;fontColor=#183c4d;" vertex="1" parent="1">
